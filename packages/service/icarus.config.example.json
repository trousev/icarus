{
  "host": "0.0.0.0",
  "port": 8080,
  "apiKey": "icarus-local-token",
  "dataDir": "~/icarus-data",
  "sessionIdleMinutes": 30,
  "docker": {
    "image": "icarus-user:dev",
    "prefix": "icarus-user",
    "network": null,
    "socket": null
  },
  "users": [
    {
      "id": "probe",
      "name": "Саня",
      "email": "probe@local.test",
      "models": [
        {
          "provider": "deepseek",
          "id": "deepseek-v4-flash",
          "thinking": "off",
          "tier": "fast"
        },
        {
          "provider": "deepseek",
          "id": "deepseek-v4-pro",
          "thinking": "medium",
          "tier": "strong"
        },
        {
          "provider": "deepseek",
          "id": "deepseek-v4-flash-vision-exp",
          "thinking": "off",
          "tier": "vision"
        }
      ],
      "auth": {
        "deepseek": "env:DEEPSEEK_API_KEY"
      },
      "mounts": [
        {
          "host": "~/src/scratchpad",
          "container": "/workspace/scratchpad",
          "mode": "ro"
        }
      ],
      "env": {
        "ICARUS_EXTRACT_AFTER_MS": "90000",
        "ICARUS_EXTRACT_MODEL": "deepseek/deepseek-v4-flash"
      },
      "mcp": {
        "echo": {
          "command": "node",
          "args": [
            "/opt/icarus/mcp/echo-server.mjs"
          ],
          "lifecycle": "eager"
        },
        "filesystem": {
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            "/workspace"
          ],
          "lifecycle": "lazy"
        }
      }
    }
  ]
}