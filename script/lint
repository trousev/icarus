#!/usr/bin/env bash
# Icarus checks: types, linter and bash scripts. There is no build — the code runs as is.
#
#   ./script/lint          everything listed (what CI runs too)
#   ./script/lint tsc      types only
#   ./script/lint eslint   linter only
#   ./script/lint shell    shellcheck over script/* only
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [ ! -x node_modules/.bin/tsc ] || [ ! -x node_modules/.bin/eslint ]; then
  echo '[x] нет инструментов проверки — сначала ./script/update' >&2
  exit 1
fi

what="${1:-all}"
case "$what" in
all | tsc | typecheck | eslint | shell) ;;
*)
  echo "не понимаю «$what»: ожидаю tsc, eslint, shell или пусто" >&2
  exit 2
  ;;
esac

if [ "$what" = all ] || [ "$what" = tsc ] || [ "$what" = typecheck ]; then
  echo '==> tsc --noEmit'
  node_modules/.bin/tsc -p tsconfig.json
fi

if [ "$what" = all ] || [ "$what" = eslint ]; then
  echo '==> eslint'
  node_modules/.bin/eslint . --max-warnings=0
fi

if [ "$what" = all ] || [ "$what" = shell ]; then
  # bash in the project is code too: script/* builds compose, installs dependencies and edits
  # configs. We take severity=warning: shellcheck's style/info are too noisy for our
  # deliberate tricks (${arr[@]+"${arr[@]}"} and single quotes with node -e).
  if command -v shellcheck >/dev/null 2>&1; then
    echo '==> shellcheck'
    shellcheck --severity=warning script/*
  elif [ -n "${CI:-}" ]; then
    # On the GitHub ubuntu image shellcheck is present out of the box, so in CI this is not "no
    # tool" but a broken runner: silently skipping the check is not allowed.
    echo '[x] в CI нет shellcheck — проверка script/* обязательна' >&2
    exit 1
  else
    echo '[!] нет shellcheck — bash-скрипты не проверены (apt install shellcheck)' >&2
  fi
fi
