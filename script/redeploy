#!/usr/bin/env bash
# Icarus production deploy: this script runs .github/workflows/deploy.yml on trousev.pro.
#
#   ./script/redeploy              normal deploy (images are built from cache)
#   ./script/redeploy --no-cache   same, but images are built from scratch
#
# The workflow does only git fetch + reset --hard and calls this script: with
# appleboy/ssh-action and script_stop a return code check is inserted after every line,
# and multi-line if/while right in the workflow break the deploy — all the logic
# lives here.
#
# Steps:
#   1. node >= 22.19 (the code runs as TypeScript) — if the host does not have it,
#      we put the official node build in ~/.local/share/icarus: there is no sudo on the host;
#   2. ./script/update — dependencies strictly by lockfile and local .env/config.yaml;
#   3. secrets from GitHub go into .env, and config.yaml is edited by render-config.ts:
#      people (ICARUS_USERS), port, dataDir, API key, panel address;
#   4. ./script/server -d — builds docker-compose.yml and brings the stack up in the background;
#   5. we wait for /healthz: while people's containers are not in place, the deploy is not green.
#
# Переменные окружения приходят из workflow (секреты — из environment production):
#   ICARUS_USERS      люди через пробел или запятую (variables.ICARUS_USERS)
#   ICARUS_API_KEY    ключ к OpenAI-совместимому эндпоинту (/v1)
#   DEEPINFRA_API_KEY ключ провайдера из models (DeepInfra)
#   TAVILY_API_KEY    ключ веб-поиска (Tavily): у DeepInfra серверного поиска нет
#   ICARUS_PORT       порт сервиса (по умолчанию 8081 — как и локально; на прод-хосте
#                     8080 занят jitsi)
#   ICARUS_DATA_DIR   каталог памяти (по умолчанию runtime/ внутри чекаута)
#   ICARUS_DNS        DNS-серверы контейнеров (по умолчанию 1.1.1.1 8.8.8.8, см. ниже)
#   ICARUS_URL        внешний адрес панели управления — его Икар называет человеку
#                     в чате (по умолчанию https://chat.trousev.pro/); явно заданный
#                     сильнее дефолта
#   ICARUS_SESSION_IDLE_MINUTES  сколько минут тишины означают «разговор закончен»
#                     (сжатие и закрытие сессии pi); по умолчанию 60 — час
#   ICARUS_TELEGRAM_MAPPING  кто из телеграма чей человек, парами «@username:человек»
#                     через запятую; пусто — маппинг из config.yaml не трогаем,
#                     `none` — убрать. Токен бота — секрет TELEGRAM_BOT_TOKEN.
#   MAPLE_DIR         каталог установки Maple на хосте (по умолчанию /opt/maple18).
#                     Оттуда же берётся путь CLI внутри контейнеров людей: сервис
#                     монтирует установку, а MAPLE_BIN в config.yaml пишется буквально.
#
# Ключей MCP здесь нет: у каждого MCP своя коллекция секретов, значения вводит
# человек в панели и они лежат в его credentials.json, а не в .env.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PORT="${ICARUS_PORT:-8081}"
DATA_DIR="${ICARUS_DATA_DIR:-$ROOT/runtime}"
# The panel lives at chat.trousev.pro (moved from memory.trousev.pro). The address is needed
# by Icarus to give a person a link: we set the default here, and an explicit ICARUS_URL
# from variables stays stronger — it can override the domain without editing code.
URL="${ICARUS_URL:-https://chat.trousev.pro/}"
# The host resolver is no friend to the containers: unbound there only allows 10.0.0.0/8, and the Docker
# resolver, getting silence from it, waits ~4 seconds for the timeout and only then goes to
# the next server — every pi request to the model became that many seconds longer, so
# we hand the containers public servers explicitly. Once the host is fixed — ICARUS_DNS=none removes the line.
DNS="${ICARUS_DNS:-1.1.1.1 8.8.8.8}"
NODE_HOME="${ICARUS_NODE_HOME:-$HOME/.local/share/icarus/node}"
NODE_URL_BASE="${ICARUS_NODE_URL:-https://nodejs.org/dist/latest-v24.x}"
HEALTH_TIMEOUT=180
NO_CACHE=0

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[!]\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[31m[x]\033[0m %s\n' "$*" >&2
  exit 1
}

for arg in "$@"; do
  case "$arg" in
  --no-cache) NO_CACHE=1 ;;
  *) die "неизвестный аргумент: $arg (ожидаю --no-cache)" ;;
  esac
done

# --- what is already on the host -----------------------------------------------
command -v docker >/dev/null 2>&1 || die 'не нашёл docker'
docker compose version >/dev/null 2>&1 || die 'не нашёл docker compose (плагин compose v2)'

# pnpm installs npm into ~/.local, so its bin must be in PATH before ./script/update.
export PATH="$HOME/.local/bin:$PATH"

# --- node ----------------------------------------------------------------------
# The code runs as TypeScript (`node file.ts`) — node >= 22.19 can do that. The host
# may have an older system node (on trousev.pro it is 20.x), and there is no way
# to install packages via apt: there is no passwordless sudo. So we put a fresh build in the home
# directory and reuse it on subsequent deploys.
node_ok() {
  local bin="${1:-}" major minor
  [ -n "$bin" ] && [ -x "$bin" ] || return 1
  major="$("$bin" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
  minor="$("$bin" -p 'process.versions.node.split(".")[1]' 2>/dev/null || echo 0)"
  [ "$major" -gt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -ge 19 ]; }
}

install_node() {
  local sums line file tmp
  say "на хосте нет node >= 22.19 — ставлю свежий node в $NODE_HOME"
  command -v curl >/dev/null 2>&1 || die 'нет curl — нечем скачать node'
  sums="$(curl -fsSL "$NODE_URL_BASE/SHASUMS256.txt")" || die 'не скачал SHASUMS256.txt с nodejs.org'
  line="$(printf '%s\n' "$sums" | awk '/linux-x64\.tar\.xz$/ {print; exit}')"
  [ -n "$line" ] || die 'в SHASUMS256.txt нет сборки linux-x64'
  file="${line##* }"
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064 # expand $tmp immediately: we must clean up our own directory
  trap "rm -rf '$tmp'" EXIT
  curl -fsSL -o "$tmp/$file" "$NODE_URL_BASE/$file" || die "не скачал $file"
  (cd "$tmp" && printf '%s\n' "$line" | sha256sum -c -) || die 'сборка node не сошлась по sha256'
  tar -xJf "$tmp/$file" -C "$tmp" || die "не распаковал $file"
  rm -rf "$NODE_HOME"
  mkdir -p "$(dirname "$NODE_HOME")"
  mv "$tmp/${file%.tar.xz}" "$NODE_HOME"
  rm -rf "$tmp"
  trap - EXIT
  PATH="$NODE_HOME/bin:$PATH"
  export PATH
}

if ! node_ok "$(command -v node 2>/dev/null)"; then
  if node_ok "$NODE_HOME/bin/node"; then
    PATH="$NODE_HOME/bin:$PATH"
    export PATH
  else
    install_node
  fi
fi
say "node $(node -v)"

# --- pnpm ----------------------------------------------------------------------
# The version — from packageManager in package.json, as in CI. corepack on the host (0.24.0)
# cannot handle pnpm 12: the package has a binary instead of bin/pnpm.cjs, which corepack looks for.
if ! command -v pnpm >/dev/null 2>&1; then
  PNPM_VERSION="$(node -p "JSON.parse(require('node:fs').readFileSync('package.json', 'utf8')).packageManager" | sed 's/^pnpm@//')"
  say "ставлю pnpm@$PNPM_VERSION в ~/.local"
  npm install -g --prefix "$HOME/.local" "pnpm@$PNPM_VERSION" || die "не поставился pnpm@$PNPM_VERSION"
fi
say "pnpm $(pnpm -v)"

# --- dependencies and local configs --------------------------------------------
# CI=1 — installation strictly by lockfile: diverged package.json and pnpm-lock.yaml
# must fail the deploy, not quietly rewrite the lockfile in prod.
say 'зависимости и локальные конфиги (./script/update)'
CI=1 ./script/update

# --- secrets from GitHub → .env -------------------------------------------------
# Keys are written neither into docker-compose.yml nor into the log: the file goes into the containers
# via env_file, and ./script/update leaves mode 600 on it.
#
# This does not cancel the panel "Keys" settings: they lie in keys.json and win over .env.
# ./script/server brings .env in line with keys.json before building the stack, so a deploy
# does not revive a key that an admin changed or removed in the panel.
upsert_env() {
  local key="$1" value="${2:-}" file="$ROOT/.env" tmp
  [ -n "$value" ] || return 0
  tmp="$(mktemp "$file.XXXXXX")"
  {
    grep -v "^${key}=" "$file" 2>/dev/null || true
    printf '%s=%s\n' "$key" "$value"
  } >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$file"
}

upsert_env DEEPINFRA_API_KEY "${DEEPINFRA_API_KEY:-}"
[ -z "${DEEPINFRA_API_KEY:-}" ] || say 'DEEPINFRA_API_KEY обновлён в .env'
upsert_env TAVILY_API_KEY "${TAVILY_API_KEY:-}"
[ -z "${TAVILY_API_KEY:-}" ] || say 'TAVILY_API_KEY обновлён в .env'
# Telegram bot token: without it the telegram block in config.yaml simply does not come up.
upsert_env TELEGRAM_BOT_TOKEN "${TELEGRAM_BOT_TOKEN:-}"
[ -z "${TELEGRAM_BOT_TOKEN:-}" ] || say 'TELEGRAM_BOT_TOKEN обновлён в .env'

# Путь к Maple: не секрет, но тоже задаётся снаружи (variables.MAPLE_DIR), чтобы
# локаль и прод настраивались одинаково. Незаданная repo-переменная приезжает из
# workflow не пустотой, а пустой строкой (envs SSH-экшена), а пустое окружение
# сильнее .env. Поэтому пустое значение считаем «не задано», подставляем дефолт и
# экспортируем его: и render-config, и compose-write, и docker compose обязаны
# видеть один и тот же путь.
MAPLE_DIR="${MAPLE_DIR:-/opt/maple18}"
export MAPLE_DIR
upsert_env MAPLE_DIR "$MAPLE_DIR"
say "MAPLE_DIR=$MAPLE_DIR записан в .env"

# --- config.yaml ---------------------------------------------------------------
# People — from variables, the API key — from a secret, DNS — from the code (ICARUS_DNS), the
# telegram mapping — from variables.ICARUS_TELEGRAM_MAPPING; we do not touch the rest in config.yaml,
# so that edits on the host (models, mounts, MCP) survive a deploy.
# An empty ICARUS_URL is the script default (chat.trousev.pro), not "leave alone":
# after the move the old panel address must not remain in the config.
say 'правлю config.yaml (люди, порт, dataDir, docker.dns, apiKey, url, telegram, час тишины)'
ICARUS_PORT="$PORT" ICARUS_DATA_DIR="$DATA_DIR" ICARUS_DNS="$DNS" \
  ICARUS_URL="$URL" \
  ICARUS_TELEGRAM_MAPPING="${ICARUS_TELEGRAM_MAPPING:-}" \
  ICARUS_SESSION_IDLE_MINUTES="${ICARUS_SESSION_IDLE_MINUTES:-60}" \
  node packages/service/src/docker/render-config.ts

# --- launch --------------------------------------------------------------------
if [ "$NO_CACHE" = 1 ]; then
  say 'собираю образы с нуля и поднимаю стек (./script/server -d --build)'
  ./script/server -d --build
else
  say 'собираю и поднимаю стек (./script/server -d)'
  ./script/server -d
fi

# --- check ---------------------------------------------------------------------
if ! command -v curl >/dev/null 2>&1; then
  warn 'нет curl — /healthz не проверяю'
  say 'деплой завершён'
  exit 0
fi

# /healthz reports the state of people's containers: missing != 0 means people are absent from docker,
# and "the deploy passed" would be a lie. The service does not come up instantly, so we wait.
say "жду /healthz на порту $PORT"
deadline=$((SECONDS + HEALTH_TIMEOUT))
health=''
while [ "$SECONDS" -lt "$deadline" ]; do
  health="$(curl -fsS "http://127.0.0.1:$PORT/healthz" 2>/dev/null || true)"
  if printf '%s' "$health" | grep -q '"ok":true' && printf '%s' "$health" | grep -q '"missing":0'; then
    break
  fi
  sleep 3
done

printf '%s' "$health" | grep -q '"ok":true' || die "сервис не ответил на /healthz за ${HEALTH_TIMEOUT}s — смотри docker compose -f docker-compose.yml logs icarus"
printf '%s' "$health" | grep -q '"missing":0' || die "icarus поднялся, но контейнеры людей не все на месте: $health"
say "готово: $health"
