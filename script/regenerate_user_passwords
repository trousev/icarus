#!/usr/bin/env bash
# Сброс паролей пользователей локального стенда LibreChat.
#
#   ./script/regenerate_user_passwords <пароль>
#   ./script/regenerate_user_passwords -    # пароль придёт со stdin
#
# Зачем это нужно. Логины стенда живут не в конфигах, а в его MongoDB (том icarus_mongo-data),
# и завести их можно только руками через UI на :3090. Пароль там лежит bcrypt-хешем, поэтому
# забытый не восстановить — остаётся перезаписать. Скрипт делает это всем пользователям сразу,
# повторяя схему самого LibreChat (bcryptjs, 10 раундов — AuthService.js), так что после него
# вход идёт обычным путём, а в конфигах менять нечего.
#
# Стенд ищется среди запущенных контейнеров: сначала имена из стека ./script/server
# --with-librechat (icarus-librechat / icarus-librechat-mongo), затем отдельный стенд
# docker/librechat/docker-compose.yml (librechat-probe / librechat-probe-mongo), потом любой
# контейнер подходящего образа. Явно имена задаются переменными LIBRECHAT_CONTAINER и
# LIBRECHAT_MONGO_CONTAINER.
#
# Сессии не разрываются — ровно как в штатном сбросе пароля у самого LibreChat.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

MONGO_URI='mongodb://127.0.0.1:27017/LibreChat'
BCRYPT_ROUNDS=10

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[!]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
./script/regenerate_user_passwords <пароль>

  <пароль>   новый пароль для всех пользователей стенда LibreChat
  -          прочитать пароль со stdin (чтобы не светить его в истории команд и в ps)
  -h, --help эта справка

Переменные окружения:
  LIBRECHAT_CONTAINER        имя контейнера LibreChat (по умолчанию ищется сам)
  LIBRECHAT_MONGO_CONTAINER  имя контейнера MongoDB стенда (по умолчанию ищется сам)
EOF
}

# --- аргументы -----------------------------------------------------------------
if [ $# -eq 0 ]; then
  usage >&2
  exit 2
fi
case "$1" in
-h | --help)
  usage
  exit 0
  ;;
esac
[ $# -eq 1 ] || die 'нужен ровно один пароль (или -, чтобы прочитать его со stdin)'

if [ "$1" = '-' ]; then
  IFS= read -r password || true
else
  password="$1"
fi
[ -n "$password" ] || die 'пустой пароль'

# --- что запущено --------------------------------------------------------------
command -v docker >/dev/null 2>&1 || die 'не нашёл docker'
docker info >/dev/null 2>&1 || die 'docker не отвечает'

# Ищем по именам, а не по проекту: стенд бывает и в стеке icarus, и отдельным compose-файлом.
pick_container() {
  local name
  for name in "$@"; do
    if docker ps --format '{{.Names}}' | grep -qx -- "$name"; then
      printf '%s' "$name"
      return 0
    fi
  done
  return 1
}

librechat="${LIBRECHAT_CONTAINER:-}"
mongo="${LIBRECHAT_MONGO_CONTAINER:-}"
[ -n "$librechat" ] || librechat="$(pick_container icarus-librechat librechat-probe || true)"
[ -n "$mongo" ] || mongo="$(pick_container icarus-librechat-mongo librechat-probe-mongo || true)"

# Запасной путь — по образу: имена контейнеров могут отличаться от ожидаемых.
if [ -z "$librechat" ]; then
  librechat="$(docker ps --format '{{.Names}}\t{{.Image}}' \
    | awk -F'\t' 'tolower($2) ~ /librechat/ && tolower($1) !~ /mongo/ { print $1; exit }')"
fi
if [ -z "$mongo" ]; then
  mongo="$(docker ps --format '{{.Names}}\t{{.Image}}' \
    | awk -F'\t' '$2 ~ /^mongo:/ { print $1; exit }')"
fi

[ -n "$librechat" ] || die 'не нашёл запущенный контейнер LibreChat — подними стенд: ./script/server --with-librechat'
[ -n "$mongo" ] || die 'не нашёл запущенный контейнер MongoDB стенда — проверь docker ps'
# Явно заданные имена не ищем, поэтому проверяем их отдельно — иначе ошибка всплывёт позже и невнятно.
running="$(docker ps --format '{{.Names}}')"
printf '%s\n' "$running" | grep -qx -- "$librechat" || die "контейнер LibreChat «$librechat» не запущен"
printf '%s\n' "$running" | grep -qx -- "$mongo" || die "контейнер MongoDB «$mongo» не запущен"

# --- хеш -----------------------------------------------------------------------
# Хешируем в контейнере LibreChat: там ровно тот же bcryptjs и та же схема, что у сервиса.
# Пароль уходит на stdin, чтобы не попасть в список процессов хоста.
hash="$(printf '%s' "$password" | docker exec -i "$librechat" node -e "
  const bcrypt = require('bcryptjs');
  let data = '';
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', (chunk) => { data += chunk; });
  process.stdin.on('end', () => process.stdout.write(bcrypt.hashSync(data, ${BCRYPT_ROUNDS})));
")" || die "не удалось посчитать bcrypt-хеш в контейнере $librechat"

# bcrypt-хеш всегда 60 символов — заодно проверка, что в ответе именно он, а не текст ошибки.
[ "${#hash}" -eq 60 ] || die "из контейнера пришёл не bcrypt-хеш: $hash"

# Хеш уезжает в mongosh шестнадцатеричным: в нём нет ни кавычек, ни \$ — экранировать нечего.
hash_hex="$(printf '%s' "$hash" | od -An -tx1 | tr -d ' \n')"

# --- обновление ----------------------------------------------------------------
say "пароли стенда: $librechat + $mongo"
out="$(docker exec -i -e ICARUS_PW_HASH_HEX="$hash_hex" "$mongo" mongosh --quiet \
  "$MONGO_URI" --file /dev/stdin <<'EOF'
const hex = process.env.ICARUS_PW_HASH_HEX;
let hash = '';
for (let i = 0; i < hex.length; i += 2) {
  hash += String.fromCharCode(parseInt(hex.substring(i, i + 2), 16));
}

const users = db.users.find({}, { username: 1, email: 1 }).toArray();
const updated = db.users.updateMany({}, { $set: { password: hash } });

for (const user of users) {
  print('  ' + (user.username || '?') + ' <' + (user.email || '?') + '>');
}
print('ICARUS_USERS=' + users.length);
print('ICARUS_UPDATED=' + updated.modifiedCount);
EOF
)" || die "mongosh не смог обновить пользователей в $mongo"

count="$(printf '%s\n' "$out" | sed -n 's/^ICARUS_USERS=\([0-9][0-9]*\)$/\1/p')"
[ -n "$count" ] || die "не понял ответ mongosh: $out"

printf '%s\n' "$out" | grep -v '^ICARUS_' || true

if [ "$count" = 0 ]; then
  warn 'в базе стенда нет ни одного пользователя — сбрасывать нечего'
  warn 'заведи их через UI (например http://localhost:3090), имя должно совпадать с users в config.yaml'
  exit 0
fi

say "готово: пароль обновлён у $count польз. — можно входить на стенд этим паролем"
