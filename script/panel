#!/usr/bin/env bash
# Local control panel: look at it on your own data, without building the stack.
#
#   ./script/panel                          panel on config.yaml, the first person from users
#   ./script/panel --user probe2            look at another person
#   ./script/panel --port 8099              another port (default 8099: 8081 is taken by the service)
#   ./script/panel --config /path/config.yaml   another config — for example, a copy with a different dataDir
#   ./script/panel --with-model             also "write it for me": a one-off question goes
#                                           into the person's container
#
# The panel works with files and git: it writes memory and skills to the same place as the real
# service, and commits them. Chat works if people's containers are already up: the panel
# talks to the same pi sessions as the service, but it does not create containers itself.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [ ! -d node_modules ]; then
  echo '[x] нет node_modules — сначала ./script/update' >&2
  exit 1
fi

exec node packages/service/src/panel.ts "$@"
