#!/usr/bin/env bash
# Стек Icarus под docker compose.
#
# ./script/server собирает docker-compose.yml из config.yaml — сервис icarus, по контейнеру
# на человека и, по флагу, стенд LibreChat — и поднимает всё через `docker compose up`.
# По умолчанию up идёт на переднем плане: логи в консоли, Ctrl-C гасит стек. С `-d` стек
# уходит в фон и живёт сам. Жизненным циклом владеет docker, а не сервис:
# `restart: unless-stopped` возвращает контейнеры и после падения, и после перезагрузки
# машины, а смена образа, маунтов или окружения приводит к пересозданию при следующем
# запуске. Выбывшие люди уходят вместе с исчезнувшим сервисом (--remove-orphans).
#
#   ./script/server                    собрать и поднять (логи в консоли)
#   ./script/server -d                 то же в фоне
#   ./script/server --with-librechat   вместе со стендом LibreChat
#   ./script/server --build            пересобрать образы без кеша
#   ./script/server --down             погасить стек
#   ./script/server --config <путь>    свой config.yaml
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

SERVICE_IMAGE="${ICARUS_SERVICE_IMAGE:-icarus-service:dev}"
COMPOSE_FILE="$ROOT/docker-compose.yml"
CONFIG="${ICARUS_CONFIG:-$ROOT/config.yaml}"
WITH_LIBRECHAT=0
DETACH=0
DOWN=0
BUILD=0

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[!]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
./script/server [--with-librechat] [--config <путь>] [-d] [--build] [--down]

  -d, --detach       поднять в фоне (по умолчанию up идёт на переднем плане)
  --with-librechat   поднять рядом стенд LibreChat (:3090)
  --config <путь>    конфиг сервиса (по умолчанию config.yaml в корне, ICARUS_CONFIG)
  --build            пересобрать образы без кеша (обычная сборка идёт всегда)
  --down             погасить стек и убрать контейнеры (память в томах остаётся)
  -h, --help         эта справка
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
  --with-librechat) WITH_LIBRECHAT=1 ;;
  --config)
    shift
    [ $# -gt 0 ] || die 'для --config нужен путь'
    CONFIG="$1"
    ;;
  -d | --detach) DETACH=1 ;;
  --build) BUILD=1 ;;
  --down) DOWN=1 ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "неизвестный аргумент: $1" >&2
    usage >&2
    exit 2
    ;;
  esac
  shift
done

# --- что нужно для compose -----------------------------------------------------
command -v docker >/dev/null 2>&1 || die 'не нашёл docker'
docker compose version >/dev/null 2>&1 || die 'не нашёл docker compose (плагин compose v2)'

# Погасить стек можно и без валидного конфига: файл уже собран прошлым запуском,
# а с флагом --with-librechat пересборка без флага оставила бы стенд висеть.
if [ "$DOWN" = 1 ]; then
  [ -f "$COMPOSE_FILE" ] || die "нет $COMPOSE_FILE — стек не поднят"
  say 'гашу стек'
  docker compose -f "$COMPOSE_FILE" down --remove-orphans
  exit 0
fi

[ -d node_modules ] || die 'нет node_modules — сначала ./script/update'
[ -f "$CONFIG" ] || die "нет конфига $CONFIG (./script/update создаёт его из config.example.yaml)"

if [ "$WITH_LIBRECHAT" = 1 ]; then
  # Каталоги стенда создаём заранее: иначе docker сделает их root-овыми.
  if [ ! -f docker/librechat/.env ]; then
    cp docker/librechat/.env.example docker/librechat/.env
    warn 'создал docker/librechat/.env из примера'
  fi
  mkdir -p docker/librechat/logs docker/librechat/uploads docker/librechat/images
fi

# --- сборка docker-compose.yml ------------------------------------------------
# Конфиг разбираем тем же загрузчиком, что и сервис: один формат — один парсер, и
# опечатка всплывает здесь, а не посреди запуска. Заодно готовим каталоги людей,
# чтобы маунты принадлежали человеку, а не root-у.
env_file=()
if [ -f packages/service/.env ]; then
  env_file=(--env-file=packages/service/.env)
fi

summary="$(mktemp)"
trap 'rm -f "$summary"' EXIT

compose_args=(packages/service/src/docker/compose-write.ts --config "$CONFIG" --out "$COMPOSE_FILE" --summary "$summary" --service-image "$SERVICE_IMAGE")
if [ "$WITH_LIBRECHAT" = 1 ]; then compose_args+=(--with-librechat); fi

if ! log="$(node ${env_file[@]+"${env_file[@]}"} "${compose_args[@]}" 2>&1)"; then
  echo "[x] не удалось собрать docker-compose.yml из $CONFIG:" >&2
  echo "$log" | sed 's/^/    /' >&2
  exit 1
fi
[ -z "$log" ] || echo "$log" >&2

PROJECT='icarus'
USER_IMAGE=''
PANEL_HOST='localhost'
PANEL_PORT='8080'
LIBRECHAT_URL=''
USER_CONTAINERS=()
while IFS=$'\t' read -r key first second; do
  case "$key" in
  project) PROJECT="$first" ;;
  service-image) SERVICE_IMAGE="$first" ;;
  user-image) USER_IMAGE="$first" ;;
  host) PANEL_HOST="$first" ;;
  port) PANEL_PORT="$first" ;;
  user) USER_CONTAINERS+=("$second") ;;
  librechat) LIBRECHAT_URL="$first" ;;
  esac
done <"$summary"

# --- образы: сначала собрать, потом пересоздавать -----------------------------
# Трюк ради меньшего простоя при обновлении: самая долгая часть — сборка образов, и она
# не должна попадать в то же окно, что пересоздание контейнеров. Собираем всё, пока старые
# контейнеры ещё работают; compose остаётся только пересоздать изменившееся — это секунды.
build_args=()
if [ "$BUILD" = 1 ]; then build_args=(--no-cache); fi

say 'собираю образы (контейнеры пока работают)'
docker compose -f "$COMPOSE_FILE" build ${build_args[@]+"${build_args[@]}"}

# Образ человека общий на всех, поэтому собирается один раз здесь, а не build-секцией
# каждого юзер-сервиса: иначе compose собирал бы его на каждого и подменял тег.
if [ -n "$USER_IMAGE" ]; then
  docker build ${build_args[@]+"${build_args[@]}"} -t "$USER_IMAGE" docker/user/
fi

# --- переезд с ручного docker run ---------------------------------------------
# Контейнеры прошлых версий сервис создавал сам: у них нет метки проекта, и compose
# не может занять их имена. Сносим только свои (по имени из конфига) и только один раз —
# дальше владельцем становится compose.
container_owner() {
  docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$1" 2>/dev/null || true
}

migrate() {
  local name="$1" owner
  docker inspect "$name" >/dev/null 2>&1 || return 0
  owner="$(container_owner "$name")"
  if [ "$owner" != "$PROJECT" ]; then
    say "переношу $name под docker compose (был создан вручную)"
    docker rm -f "$name" >/dev/null
  fi
}

for name in "${USER_CONTAINERS[@]+"${USER_CONTAINERS[@]}"}"; do
  migrate "$name"
done
# Контейнер сервиса из самой первой версии compose: имя сменилось на icarus.
if docker inspect icarus-icarus-1 >/dev/null 2>&1 && [ "$(container_owner icarus-icarus-1)" = "$PROJECT" ]; then
  say 'сношу старый контейнер сервиса icarus-icarus-1 (теперь он называется icarus)'
  docker rm -f icarus-icarus-1 >/dev/null
fi

# --- запуск -------------------------------------------------------------------
echo
echo "==> поднимаю стек"
echo "    сервис:        http://$PANEL_HOST:$PANEL_PORT/v1"
echo "    панель памяти: http://$PANEL_HOST:$PANEL_PORT/panel?key=<panelKey>"
if [ -n "$LIBRECHAT_URL" ]; then
  echo "    LibreChat:     $LIBRECHAT_URL"
fi

if [ "$DETACH" = 1 ]; then
  docker compose -f "$COMPOSE_FILE" up -d --remove-orphans
  echo '    логи:          docker compose -f docker-compose.yml logs -f'
  echo '    остановить:    ./script/server --down'
else
  echo '    логи ниже; Ctrl-C гасит стек, для фона — ./script/server -d'
  echo '    остановить:    Ctrl-C или ./script/server --down'
  echo
  exec docker compose -f "$COMPOSE_FILE" up --remove-orphans
fi
