#!/usr/bin/env bash
# Icarus stack under docker compose.
#
# ./script/server builds docker-compose.yml from config.yaml — the icarus service and one container
# per person — and brings everything up via `docker compose up`.
# By default up runs in the foreground: logs in the console, Ctrl-C shuts the stack down. With `-d` the stack
# goes to the background and lives on its own. The lifecycle is owned by docker, not the service:
# `restart: unless-stopped` brings containers back both after a crash and after a machine
# reboot, and a change of image, mounts or environment leads to recreation on the next
# start. Departed people leave together with the disappeared service (--remove-orphans).
#
#   ./script/server                    build and bring up (logs in the console)
#   ./script/server -d                 same in the background
#   ./script/server --build            rebuild images without cache
#   ./script/server --down             shut the stack down
#   ./script/server --config <path>    your own config.yaml
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

SERVICE_IMAGE="${ICARUS_SERVICE_IMAGE:-icarus-service:dev}"
COMPOSE_FILE="$ROOT/docker-compose.yml"
CONFIG="${ICARUS_CONFIG:-$ROOT/config.yaml}"
DETACH=0
DOWN=0
BUILD=0

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[!]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
./script/server [--config <путь>] [-d] [--build] [--down]

  -d, --detach       поднять в фоне (по умолчанию up идёт на переднем плане)
  --config <путь>    конфиг сервиса (по умолчанию config.yaml в корне, ICARUS_CONFIG)
  --build            пересобрать образы без кеша (обычная сборка идёт всегда)
  --down             погасить стек и убрать контейнеры (память в томах остаётся)
  -h, --help         эта справка
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
  --config)
    shift
    [ $# -gt 0 ] || die 'для --config нужен путь'
    CONFIG="$1"
    ;;
  -d | --detach) DETACH=1 ;;
  --build) BUILD=1 ;;
  --down) DOWN=1 ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "неизвестный аргумент: $1" >&2
    usage >&2
    exit 2
    ;;
  esac
  shift
done

# --- what compose needs --------------------------------------------------------
command -v docker >/dev/null 2>&1 || die 'не нашёл docker'
docker compose version >/dev/null 2>&1 || die 'не нашёл docker compose (плагин compose v2)'

# The stack can be shut down even without a valid config: the file was already built by the previous run.
if [ "$DOWN" = 1 ]; then
  [ -f "$COMPOSE_FILE" ] || die "нет $COMPOSE_FILE — стек не поднят"
  say 'гашу стек'
  docker compose -f "$COMPOSE_FILE" down --remove-orphans
  exit 0
fi

[ -d node_modules ] || die 'нет node_modules — сначала ./script/update'
[ -f "$CONFIG" ] || die "нет конфига $CONFIG (./script/update создаёт его из config.example.yaml)"

# --- building docker-compose.yml ----------------------------------------------
# We parse the config with the same loader as the service: one format — one parser, and
# a typo surfaces here, not in the middle of a start. At the same time we prepare people's directories,
# so that the mounts belong to the person, not to root. The generator reads the keys from .env itself,
# and only the path to the file gets into compose — values are not written into docker-compose.yml.
summary="$(mktemp)"
trap 'rm -f "$summary"' EXIT

compose_args=(packages/service/src/docker/compose-write.ts --config "$CONFIG" --out "$COMPOSE_FILE" --summary "$summary" --service-image "$SERVICE_IMAGE")

if ! log="$(node "${compose_args[@]}" 2>&1)"; then
  echo "[x] не удалось собрать docker-compose.yml из $CONFIG:" >&2
  echo "$log" | sed 's/^/    /' >&2
  exit 1
fi
[ -z "$log" ] || echo "$log" >&2

PROJECT='icarus'
USER_IMAGE=''
PANEL_HOST='localhost'
PANEL_PORT='8081'
USER_CONTAINERS=()
while IFS=$'\t' read -r key first second; do
  case "$key" in
  project) PROJECT="$first" ;;
  service-image) SERVICE_IMAGE="$first" ;;
  user-image) USER_IMAGE="$first" ;;
  host) PANEL_HOST="$first" ;;
  port) PANEL_PORT="$first" ;;
  user) USER_CONTAINERS+=("$second") ;;
  esac
done <"$summary"

# --- panel port: either free or ours ------------------------------------------
# Port publication in docker is silent: if the port is already taken, the container comes up
# without network and without publication, and the browser talks to someone else's service on the same port.
# The symptom — "Icarus is silent", and the cause is outside: a forgotten dev service from a previous session
# or someone else's container. We fail here while it is visible.
# Our own project is no obstacle: compose recreates the container and the port is freed.
if (exec 3<>"/dev/tcp/$PANEL_HOST/$PANEL_PORT") 2>/dev/null; then
  exec 3<&- 3>&-
  if [ -z "$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" --filter "publish=$PANEL_PORT" 2>/dev/null)" ]; then
    # Who took it: the container is visible to docker, a host process — via ss (docker-proxy
    # runs as root, so the pid in ss is only available to us, and vice versa).
    # || true — because an empty hint is normal: without it pipefail kills the script
    # before the diagnostics (grep without matches returns 1).
    busy="$(docker ps --filter "publish=$PANEL_PORT" --format '{{.Names}} ({{.Image}})' 2>/dev/null | tr '\n' ' ' || true)"
    busy="${busy% }"
    pid=''
    if command -v ss >/dev/null 2>&1; then
      pid="$(ss -ltnpH "sport = :$PANEL_PORT" 2>/dev/null | grep -oE 'pid=[0-9]+' | head -n1 | cut -d= -f2 || true)"
    fi
    [ -z "$pid" ] || busy="${busy:+$busy, }pid $pid: $(ps -o args= -p "$pid" 2>/dev/null | cut -c1-100)"
    die "порт $PANEL_PORT занят не нашим compose-проектом${busy:+ — $busy}; освободите его или поменяйте port в конфиге"
  fi
fi

# --- images: build first, recreate later --------------------------------------
# A trick for less downtime during an update: the longest part is building images, and it
# must not fall into the same window as recreating containers. We build everything while the old
# containers are still running; compose only has to recreate what changed — that is seconds.
build_args=()
if [ "$BUILD" = 1 ]; then build_args=(--no-cache); fi

say 'собираю образы (контейнеры пока работают)'
docker compose -f "$COMPOSE_FILE" build ${build_args[@]+"${build_args[@]}"}

# The person image is common to all, so it is built once here, not by a build section
# of each user service: otherwise compose would build it for each one and replace the tag.
if [ -n "$USER_IMAGE" ]; then
  docker build ${build_args[@]+"${build_args[@]}"} -t "$USER_IMAGE" docker/user/
fi

# --- migration from manual docker run -----------------------------------------
# The service used to create previous versions' containers itself: they have no project label, and compose
# cannot take their names. We remove only our own (by the name from the config) and only once —
# after that compose becomes the owner.
container_owner() {
  docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$1" 2>/dev/null || true
}

migrate() {
  local name="$1" owner
  docker inspect "$name" >/dev/null 2>&1 || return 0
  owner="$(container_owner "$name")"
  if [ "$owner" != "$PROJECT" ]; then
    say "переношу $name под docker compose (был создан вручную)"
    docker rm -f "$name" >/dev/null
  fi
}

for name in "${USER_CONTAINERS[@]+"${USER_CONTAINERS[@]}"}"; do
  migrate "$name"
done
# The service container from the very first compose version: the name changed to icarus.
if docker inspect icarus-icarus-1 >/dev/null 2>&1 && [ "$(container_owner icarus-icarus-1)" = "$PROJECT" ]; then
  say 'сношу старый контейнер сервиса icarus-icarus-1 (теперь он называется icarus)'
  docker rm -f icarus-icarus-1 >/dev/null
fi

# --- launch -------------------------------------------------------------------
echo
echo "==> поднимаю стек"
echo "    API:           http://$PANEL_HOST:$PANEL_PORT/v1"
echo "    панель:        http://$PANEL_HOST:$PANEL_PORT/panel (вход — через SSO-прокси)"
echo "    telegram:      бот поднимается сам, если в config есть telegram.mapping и токен в .env"

if [ "$DETACH" = 1 ]; then
  docker compose -f "$COMPOSE_FILE" up -d --remove-orphans
  echo '    логи:          docker compose -f docker-compose.yml logs -f'
  echo '    остановить:    ./script/server --down'
else
  echo '    логи ниже; Ctrl-C гасит стек, для фона — ./script/server -d'
  echo '    остановить:    Ctrl-C или ./script/server --down'
  echo
  exec docker compose -f "$COMPOSE_FILE" up --remove-orphans
fi
