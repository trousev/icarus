#!/usr/bin/env bash
# Запуск сервиса Icarus. По умолчанию поднимается только сам сервис на :8080;
# стенд LibreChat — по флагу --with-librechat (на :3090), и он же гасится на выходе.
#
#   ./script/server
#   ./script/server --with-librechat
#   ./script/server --with-librechat --config /path/to/config.yaml
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

COMPOSE=(docker compose -f docker/librechat/docker-compose.yml)
WITH_LIBRECHAT=0
CONFIG="${ICARUS_CONFIG:-$ROOT/config.yaml}"

usage() {
  cat <<'EOF'
./script/server [--with-librechat] [--config <путь>]

  --with-librechat   поднять рядом стенд LibreChat (docker compose) и погасить его на выходе
  --config <путь>    конфиг сервиса (по умолчанию config.yaml в корне, ICARUS_CONFIG)
  -h, --help         эта справка
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
  --with-librechat) WITH_LIBRECHAT=1 ;;
  --config)
    shift
    [ $# -gt 0 ] || { echo 'для --config нужен путь' >&2; exit 2; }
    CONFIG="$1"
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "неизвестный аргумент: $1" >&2
    usage >&2
    exit 2
    ;;
  esac
  shift
done

if [ ! -d node_modules ]; then
  echo '[x] нет node_modules — сначала ./script/update' >&2
  exit 1
fi

if [ ! -f "$CONFIG" ]; then
  echo "[x] нет конфига $CONFIG" >&2
  echo '    ./script/update создаёт его из config.example.yaml' >&2
  exit 1
fi

# Ключи провайдеров: в config.yaml на них ссылаются как env:VAR, поэтому подкладываем
# packages/service/.env. Уже заданные в окружении переменные он не перетирает.
env_file=()
if [ -f packages/service/.env ]; then
  env_file=(--env-file=packages/service/.env)
fi

# Конфиг разбираем тем же загрузчиком, что и сервис: один формат — один парсер,
# и опечатка в config.yaml всплывает здесь, а не посреди запуска.
# Заодно берём оттуда образ и адрес: сервис образ пользователя сам не собирает.
if ! cfg_info="$(node ${env_file[@]+"${env_file[@]}"} --input-type=module -e '
  const { loadConfig } = await import("./packages/service/src/config.ts");
  try {
    const cfg = loadConfig(process.argv[1]);
    process.stdout.write([cfg.docker.image, cfg.host, cfg.port].join(" "));
  } catch (error) {
    process.stdout.write(error instanceof Error ? error.message : String(error));
    process.exit(1);
  }
' "$CONFIG" 2>&1)"; then
  echo "[x] конфиг $CONFIG не читается:" >&2
  echo "    $cfg_info" >&2
  exit 1
fi
read -r image host port <<<"$cfg_info"
panel_host="$host"
if [ "$panel_host" = '0.0.0.0' ]; then panel_host='localhost'; fi

if command -v docker >/dev/null 2>&1; then
  docker image inspect "$image" >/dev/null 2>&1 \
    || echo "[!] образа $image нет — собери: docker build -t $image docker/user/" >&2
else
  echo '[!] docker не найден: контейнеры пользователей поднять не выйдет' >&2
fi

librechat_started=0
librechat_stopped=0
cleanup() {
  # EXIT и INT могут сработать подряд — гасим стенд ровно один раз.
  if [ "$librechat_started" = 1 ] && [ "$librechat_stopped" = 0 ]; then
    librechat_stopped=1
    echo '==> гашу стенд LibreChat'
    "${COMPOSE[@]}" down || true
  fi
}
trap cleanup EXIT INT TERM

if [ "$WITH_LIBRECHAT" = 1 ]; then
  command -v docker >/dev/null 2>&1 || { echo '[x] для --with-librechat нужен docker' >&2; exit 1; }
  if [ ! -f docker/librechat/.env ]; then
    cp docker/librechat/.env.example docker/librechat/.env
    echo '[!] создал docker/librechat/.env из примера'
  fi
  echo '==> поднимаю стенд LibreChat (:3090)'
  "${COMPOSE[@]}" up -d
  librechat_started=1
fi

echo "==> icarus на конфиге $CONFIG"
echo "    сервис:        http://$panel_host:$port/v1"
echo "    панель памяти: http://$panel_host:$port/panel?key=<panelKey>"
if [ "$WITH_LIBRECHAT" = 1 ]; then
  echo '    LibreChat:     http://localhost:3090'
fi
node ${env_file[@]+"${env_file[@]}"} packages/service/src/index.ts "$CONFIG"
