#!/usr/bin/env bash
# Тесты Icarus. Докер и модель не нужны: pi, контейнеры и сеть подменяются заглушками.
#
#   ./script/test                                  весь набор
#   ./script/test packages/service/test/title.test.ts
#                                                  один файл
#   ./script/test --test-name-pattern='память'     фильтр по имени теста
#
# Любые флаги node --test передаются насквозь и должны идти до имён файлов.
# Сценарные тесты с живым докером включаются переменной ICARUS_E2E=1.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [ ! -d node_modules ]; then
  echo '[x] нет node_modules — сначала ./script/update' >&2
  exit 1
fi

# Если файлы не названы, берём все тесты под packages/. Именно find, а не маска
# одного каталога: тест, положенный в новый подкаталог, не должен молча выпасть
# из прогона — незапущенный тест хуже упавшего.
files=()
for arg in "$@"; do
  case "$arg" in
  -*) ;;
  *.ts | *.js | *.mjs | *.cjs) files+=("$arg") ;;
  esac
done

if [ ${#files[@]} -eq 0 ]; then
  [ -d packages ] || {
    echo '[x] нет каталога packages — запускать нечего' >&2
    exit 1
  }
  mapfile -t files < <(
    find packages \
      -type d -name node_modules -prune -o \
      -type f \( -name '*.test.ts' -o -name '*.test.mjs' -o -name '*.test.js' \) -print |
      LC_ALL=C sort
  )
fi

if [ ${#files[@]} -eq 0 ]; then
  echo '[x] не нашёл ни одного теста: ожидаю packages/**/*.test.ts' >&2
  exit 1
fi

echo "==> node --test: ${#files[@]} файл(ов)"
exec node --test "$@" "${files[@]}"
