#!/usr/bin/env bash
# Icarus tests. Docker and a model are not needed: pi, containers and the network are replaced by stubs.
#
#   ./script/test                                  the whole set
#   ./script/test packages/service/test/title.test.ts
#                                                  one file
#   ./script/test --test-name-pattern='память'     filter by test name
#
# Any node --test flags are passed through and must come before the file names.
# Scenario tests with a live docker are enabled by the ICARUS_E2E=1 variable.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [ ! -d node_modules ]; then
  echo '[x] нет node_modules — сначала ./script/update' >&2
  exit 1
fi

# If no files are named, we take all tests under packages/. Exactly find, not a mask
# of one directory: a test placed in a new subdirectory must not silently fall out
# of the run — a test not run is worse than a failed one.
files=()
for arg in "$@"; do
  case "$arg" in
  -*) ;;
  *.ts | *.js | *.mjs | *.cjs) files+=("$arg") ;;
  esac
done

if [ ${#files[@]} -eq 0 ]; then
  [ -d packages ] || {
    echo '[x] нет каталога packages — запускать нечего' >&2
    exit 1
  }
  mapfile -t files < <(
    find packages \
      -type d -name node_modules -prune -o \
      -type f \( -name '*.test.ts' -o -name '*.test.mjs' -o -name '*.test.js' \) -print |
      LC_ALL=C sort
  )
fi

if [ ${#files[@]} -eq 0 ]; then
  echo '[x] не нашёл ни одного теста: ожидаю packages/**/*.test.ts' >&2
  exit 1
fi

echo "==> node --test: ${#files[@]} файл(ов)"
exec node --test "$@" "${files[@]}"
