# Upstream OpenAI-compatible API base URL
UPSTREAM_BASE_URL=https://api.deepseek.com

# Upstream API key (forwarded to upstream)
UPSTREAM_API_KEY=sk-your-key-here

# Static memory chunk injected as a second system message
MEMORY_INJECTION="The user's name is Alex. They prefer concise answers. They are a senior engineer."

# Host and port for the proxy
HOST=0.0.0.0
PORT=8000

# Log directory for request/response logging
LOG_DIR=./logs

# Set to "true" to include full prompt/response bodies in log files.
# Default (empty/false): only metadata, timing, and cache metrics are logged.
LOG_PROMPTS=false
