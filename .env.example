# Upstream OpenAI-compatible API base URL.
# Authentication is forwarded from the client (LibreChat's apiKey).
UPSTREAM_BASE_URL=https://api.deepseek.com

# Static memory chunk injected as a second system message.
# Ignored when MEMORY_ENABLED=true (dynamic memory via Graphiti).
MEMORY_INJECTION="The user's name is Alex. They prefer concise answers. They are a senior engineer."

# Host and port for the proxy
HOST=0.0.0.0
PORT=8000

# Log directory for request/response logging
LOG_DIR=./logs

# Set to "true" to include full prompt/response bodies in log files.
# Default (empty/false): only metadata, timing, and cache metrics are logged.
LOG_PROMPTS=false

# ── Memory system (Graphiti knowledge graph) ────────────────────────────────

# Enable dynamic memory via Graphiti. When false, falls back to MEMORY_INJECTION.
# MEMORY_ENABLED=true

# Graphiti MCP server URL
# GRAPHITI_URL=http://localhost:8001/mcp

# Port for the Graphiti service (docker-compose)
# GRAPHITI_PORT=8001

# Group ID for multi-tenant isolation in the knowledge graph
# GRAPHITI_GROUP_ID=default

# Model used by Graphiti for entity/edge extraction (OpenAI model)
# GRAPHITI_EXTRACTOR_MODEL=gpt-4o-mini
# GRAPHITI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI API key (required for LLM extraction + embeddings when MEMORY_ENABLED=true)
# OPENAI_API_KEY=sk-your-openai-key-here
