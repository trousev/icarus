# Icarus keys. The working file is .env next to this one; ./script/update copies it from here.
# It does not go into git, mode 600 — only secrets live here, nothing else.
#
# How it works:
#   * a provider key from models is picked up automatically and goes into the container's auth.json
#     (the list of names is in packages/service/src/config.ts, PROVIDER_ENV);
#   * everything else from the file goes entirely into the environment of the user containers —
#     extensions use that;
#   * an environment variable wins over the file: export DEEPINFRA_API_KEY=... overrides the line
#     below; an empty environment value does not count as set — otherwise an unset
#     variable from CI would wipe a working value from the file.
#
# The file is not edited only by a human: the "Keys" section in the panel (admin only) reads
# and rewrites it, preserving comments. Panel edits also live in
# keys.json next to it: it wins over .env and survives a deploy that pours GitHub
# secrets back into this file.
#
# After editing by hand: ./script/server — docker compose will recreate the service and containers.
# After an edit in the panel nothing needs rebuilding: the next conversation gets the
# new keys by itself (except the Telegram token — it is picked up after the service restarts).

# Provider deepinfra from config.yaml (models). Key — at https://deepinfra.com/dash/api_keys
# The same key is used to transcribe Telegram voice messages (Whisper, see speech in config.yaml).
DEEPINFRA_API_KEY=

# Internet search. DeepInfra has no server-side web search of its own, so we search with
# separate keys. The service keeps a /search router: it picks a live
# provider by rating and routes around the failed ones.
#
#   refusal or timeout  — 5 minutes of quarantine;
#   "out of credits"    — one day;
#   50 refusals in a row — "key broken" and 7 days (visible in the panel, "Keys" section).
#
# One key is enough; each next one is a little more free quota.
# The order below is the router's rating: Google results on top, Linkup is the fallback.
SERPAPI_API_KEY=
SERPSTACK_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
YOU_API_KEY=
LINKUP_API_KEY=
#
# There may be no keys at all: You.com has a free MCP profile without
# registration — 100 searches a day, no key needed. The router calls it itself, like
# any other provider (in the rating — right after You.com with a key). It can only
# search, it cannot read pages: web_fetch still needs a key.
# Disable: ICARUS_SEARCH_FREE=off. Default is on.
ICARUS_SEARCH_FREE=on
#
# Exa, Tavily, Linkup and You.com can also read pages (web_fetch): same
# keys, same credits. Firecrawl and SerpApi are deliberately not used for extraction.
#
# Cloudflare Browser Run — the cheapest way to get markdown of pages (we pay
# for browser time, 10 minutes a day free). While it is not in quarantine, fetch
# always picks it. Both values are needed: account and a token with Browser Run - Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
#
# The service itself sets ICARUS_SEARCH_URL=http://icarus:<port> for containers, so
# by default web_search goes through the router. The variables below are only needed to
# bring back the old single mode:
#   ICARUS_SEARCH_PROVIDER   router (default) | tavily | brave | searxng | none
#   ICARUS_SEARCH_DEPTH      basic (default) | advanced — deeper and more expensive
#   ICARUS_SEARXNG_URL       address of your SearXNG for ICARUS_SEARCH_PROVIDER=searxng

# Icarus Telegram bot: token from @BotFather (the_icarus_bot). This is the main entry,
# so without it the service comes up but has nowhere to talk: the bot does not start
# while config.yaml has no telegram block with mapping.
# The token goes into the user containers along with the rest of .env, but only the service reads it.
TELEGRAM_BOT_TOKEN=

# Key to MCP Home Assistant (config.yaml → mcp.homeassistant). The
# MCP server has no separate issue: the key is the HA long-lived access token itself, it is also the Bearer.
# Issue it: <HA address>/profile/security → "Long-lived access tokens" → "Create token".
# The key is shown once and lives 10 years; any user can issue it,
# but the endpoint will only let an administrator in if the Model Context Protocol
# Server integration has "Require an administrator account" enabled (for new entries — enabled;
# a non-admin gets 403 from the endpoint, not 401). "Expose all LLM APIs" there decides what
# exactly is available.
# MCP in the config is shared by all people, so everyone who
# messages Icarus gets access to the home — the key is worth issuing with that in mind.
HOMEASSISTANT_TOKEN=

# Where Maple lives on the host. By this variable the service mounts the installation into the
# agent container at the same path (host == container) and substitutes the path to the CLI:
#   mcp.maple.env.MAPLE_BIN: ${MAPLE_DIR}/bin/maple
# Important: the container path must match the host — the Maple launcher looks for its
# libraries by the same path recorded inside itself. The server keeps journals and charts
# itself, in the conversation working folder: there is nothing to configure for them.
MAPLE_DIR=/opt/maple18
