# Ключи Icarus. Рабочий файл — .env рядом с этим; ./script/update копирует его отсюда.
# В git не попадает, права 600 — тут лежат только секреты, ничего другого.
#
# Как это работает:
#   * ключ провайдера из models подхватывается сам и уезжает в auth.json контейнера
#     (список имён — в packages/service/src/config.ts, PROVIDER_ENV);
#   * всё остальное из файла целиком попадает в окружение контейнеров людей — этим
#     пользуются расширения;
#   * переменная окружения сильнее файла: export DEEPINFRA_API_KEY=... перебьёт строку ниже.
#
# После правки: ./script/server — сервис и контейнеры пересоздаст docker compose.

# Провайдер deepinfra из config.yaml (models). Ключ — на https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Поиск в интернете — Tavily. Своего серверного веб-поиска у DeepInfra нет, поэтому
# ищем отдельным ключом: https://app.tavily.com (бесплатного тарифа хватает с запасом).
# Переключатели (все необязательные):
#   ICARUS_SEARCH_PROVIDER   tavily (по умолчанию) | brave | searxng | none
#   ICARUS_SEARCH_DEPTH      basic (по умолчанию) | advanced — advanced ищет глубже и дороже
# Альтернативы, если понадобятся: BRAVE_API_KEY (на https://brave.com/search/api/) вместе с
# ICARUS_SEARCH_PROVIDER=brave или ICARUS_SEARXNG_URL вместе с ICARUS_SEARCH_PROVIDER=searxng.
TAVILY_API_KEY=
# BRAVE_API_KEY=
