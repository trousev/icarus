# ── Required ─────────────────────────────────────────────────────────────────
# API key for your LLM provider (DeepSeek, Anthropic, etc.)
ANTHROPIC_AUTH_TOKEN=sk-your-key-here

# ── DeepSeek (recommended for cost) ──────────────────────────────────────────
ANTHROPIC_BASE_URL=https://api.deepseek.com
ANTHROPIC_MODEL=deepseek-v4-pro

# ── Anthropic (alternative) ──────────────────────────────────────────────────
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── icarus settings ──────────────────────────────────────────────────────────
ICARUS_HOST=0.0.0.0
ICARUS_PORT=9090
ICARUS_MAX_TURNS=50
ICARUS_MAX_BUDGET_USD=0.50
ICARUS_LOG_LEVEL=info
# ICARUS_ALLOWED_TOOLS=Read,Grep,Glob,Bash
# ICARUS_READONLY=1
# ICARUS_REQUEST_TIMEOUT=300
